# Copia este archivo a .env y ajusta los valores.
# .env NO se sube al repositorio (está en .gitignore).

# Nivel de log: DEBUG, INFO, WARNING, ERROR
ASTRONOMIA_LOG_LEVEL=INFO

# Abrir las herramientas de desarrollo del navegador embebido (0/1)
ASTRONOMIA_DEVTOOLS=0

# Coordenadas iniciales del mapa (objeto o "RA DEC")
ASTRONOMIA_TARGET_INICIAL=M31

# Campo de visión inicial en grados
ASTRONOMIA_FOV_INICIAL=1.5
